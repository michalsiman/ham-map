# Mirrors the schedule used on the production server.
0  3 * * * root php /var/www/html/cron/synchro.php  >> /proc/1/fd/1 2>&1
10 3 * * * root php /var/www/html/cron/synchro2.php >> /proc/1/fd/1 2>&1
20 3 * * * root php /var/www/html/cron/synchro3.php >> /proc/1/fd/1 2>&1
30 3 * * * root php /var/www/html/cron/synchro4.php >> /proc/1/fd/1 2>&1
40 3 * * * root php /var/www/html/cron/synchro5.php >> /proc/1/fd/1 2>&1
