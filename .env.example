# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit your real .env file.

# --- Database (used by both the web app and docker-compose's db service) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=wwff_maps
DB_USER=wwff
DB_PASS=change-me
# Root password for the MariaDB container itself (first boot only)
DB_ROOT_PASS=change-me-too

# --- Mapy.cz tiles API key ---
# Free key: https://developer.mapy.cz/
MAPY_CZ_API_KEY=
